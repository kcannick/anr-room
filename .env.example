# ── How email codes get sent ──────────────────────────────
# console  = print the code to the server log / show on screen (no real email; great for testing)
# resend   = real email via Resend  (set RESEND_API_KEY + EMAIL_FROM)
# mandrill = real email via Mailchimp Transactional (set MANDRILL_API_KEY + EMAIL_FROM)
EMAIL_PROVIDER=console

# Sender identity for real email (Resend/Mandrill). Use a verified domain.
EMAIL_FROM=Room Tone <onboarding@resend.dev>

# Resend
RESEND_API_KEY=

# Mailchimp Transactional (Mandrill)
MANDRILL_API_KEY=

# ── Database ──────────────────────────────────────────────
# Leave DATABASE_URL UNSET to use a local SQLite file (local laptop mode).
# Set it to a Postgres connection string for deployed mode (Vercel/Neon/Supabase).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# PGSSL=disable   # only if your Postgres does NOT use SSL

# Local SQLite file path (local mode only)
SQLITE_PATH=./roomtone.db

# Port (local mode)
PORT=3000

# ── Realtime (Ably) ───────────────────────────────────────
# Server-side root key from the Ably app (API Keys tab). Format: appId.keyId:secret.
# When set, clients subscribe for instant round/leaderboard updates; when unset,
# the app falls back to polling automatically. Never shipped to the browser.
ABLY_API_KEY=

# ── SMS (Twilio) — go-live text notifications ─────────────
# console (default) = log only, no real texts. twilio = real sends.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Prefer a Messaging Service (A2P 10DLC); or set a single TWILIO_FROM number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# ── Ingest from the review site (makinitmag.com/review) ───
# One-at-a-time push from the submission form into the host's queue form.
INGEST_TOKEN=
# A&R Daily's approved daily batch. SEPARATE from INGEST_TOKEN on purpose: this one
# creates a live day carrying up to 16 artists' email addresses and phone numbers,
# where /ingest/submission only stages a single ignorable row. Unset = 503.
DAILY_INGEST_TOKEN=

# ── Scheduled jobs (Vercel Cron) ──────────────────────────
# Gates /api/cron/artist-sms (hourly) and /api/cron/daily (*/5). Unset = 503, which
# means the drop never opens and the artist texts never send.
# Vercel Pro is REQUIRED: a Hobby account fails the deploy on a */5 expression.
CRON_SECRET=

# ── Hosted images (Vercel Blob) ───────────────────────────
# Share cards, Song Report pages, and the Top 8 graphics in the daily results email.
# Missing: the day still publishes and results still reveal, but the email has no graphics.
BLOB_READ_WRITE_TOKEN=

# ── Signed "manage your notifications" links ──────────────
# Without it every email footer degrades to a plain login link. Strongly recommended
# once A&R Daily is sending every day.
NOTIFY_LINK_SECRET=

# Base URL for links built OUTSIDE a request (the daily cron has no incoming host to
# read). Defaults to https://anr.makinitmag.com — set it on preview/staging or those
# deployments will mail links pointing at production.
PUBLIC_BASE_URL=

# ── Asana (optional) — the post kit task ──────────────────
# Personal access token. Deliberately NOT in the settings table: a PAT there would be
# echoed back by the platform GET to every admin. The project gid is not a secret and
# does live in settings.
ASANA_TOKEN=
